#include <stdio.h>
#include <windows.h>

// 키가 현재 눌려있는지 확인
// 16진수 이진수로는 1000 0000 0000 0000 -> 15번 비트만 가져오기 위해 아래와 같은
// (GetAsyncKeyState(keycode) & 0x8000) != 0; 출력

static int platform_key_down(int keycode) {
    return (GetAsyncKeyState(keycode) & 0x8000) != 0;
}

#define SCR_W      80
#define SCR_H      30
#define PIX_W      40        // 픽셀 1칸 = 콘솔 2칸
#define PIX_H      28        // 마지막 2줄은 UI
#define WORLD_W    100
#define WORLD_H    100

int playerX = 50;
int playerY = 50;
int cameraX = 0;
int cameraY = 0;

void draw_pixel(int sx, int sy, int r, int g, int b) {
    if (sx < 0 || sx >= PIX_W || sy < 0 || sy >= PIX_H) return;
    printf("\033[%d;%dH\033[48;2;%d;%d;%dm  \033[0m", sy + 1, (sx * 2) + 1, r, g, b);
}

void update_camera() {
    int px = playerX - cameraX;
    int py = playerY - cameraY;
    if (px < PIX_W / 3) cameraX = playerX - PIX_W / 3;
    if (px > PIX_W * 2 / 3) cameraX = playerX - PIX_W * 2 / 3;
    if (py < PIX_H / 3) cameraY = playerY - PIX_H / 3;
    if (py > PIX_H * 2 / 3) cameraY = playerY - PIX_H * 2 / 3;
    if (cameraX < 0) cameraX = 0;
    if (cameraX > WORLD_W - PIX_W) cameraX = WORLD_W - PIX_W;
    if (cameraY < 0) cameraY = 0;
    if (cameraY > WORLD_H - PIX_H) cameraY = WORLD_H - PIX_H;
}

void render() {
    for (int y = 0; y < PIX_H; y++)
        for (int x = 0; x < PIX_W; x++)
            draw_pixel(x, y, 10, 10, 40);

    for (int wx = 0; wx < WORLD_W; wx += 5) {
        int sx = wx - cameraX;
        if (sx >= 0 && sx < PIX_W)
            for (int sy = 0; sy < PIX_H; sy++)
                draw_pixel(sx, sy, 70, 70, 70);
    }
    for (int wy = 0; wy < WORLD_H; wy += 5) {
        int sy = wy - cameraY;
        if (sy >= 0 && sy < PIX_H)
            for (int sx = 0; sx < PIX_W; sx++)
                draw_pixel(sx, sy, 70, 70, 70);
    }

    draw_pixel(playerX - cameraX, playerY - cameraY, 255, 220, 0);

    int camCX = cameraX + PIX_W / 2;
    int camCY = cameraY + PIX_H / 2;
    int pCamX = playerX - cameraX;
    int pCamY = playerY - cameraY;

    printf("\033[%d;1H\033[0m\033[K", PIX_H + 1);
    printf(" CAM(world):(%3d,%3d)  PLAYER(cam):(%3d,%3d)  PLAYER(world):(%3d,%3d)",
        camCX, camCY, pCamX, pCamY, playerX, playerY);
    printf("\033[%d;1H\033[K", PIX_H + 2);
    printf(" [Arrow keys / WASD: move]  [Q: quit]");
    fflush(stdout);
}

int main() {

    printf("\033[2J\033[?25l");
    update_camera();

    while (1) {
        if (platform_key_down('Q')) break;

        if (platform_key_down(37) && playerX > 0)           playerX--;
        if (platform_key_down(39) && playerX < WORLD_W - 1) playerX++;
        if (platform_key_down(38) && playerY > 0)           playerY--;
        if (platform_key_down(40) && playerY < WORLD_H - 1) playerY++;

        if (platform_key_down('A') && playerX > 0)           playerX--;
        if (platform_key_down('D') && playerX < WORLD_W - 1) playerX++;
        if (platform_key_down('W') && playerY > 0)           playerY--;
        if (platform_key_down('S') && playerY < WORLD_H - 1) playerY++;

        update_camera();
        render();
        Sleep(16);
    }

    printf("\033[?25h\033[2J\033[1;1H");
    printf("끝났습니다.\n");
    return 0;
}
